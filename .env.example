# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MAX_DAILY_AI_CALLS: Daily server-side cap on live Gemini AI calls for visitors (default: 700).
# Resets at midnight Pacific Time (America/Los_Angeles).
# Once reached, the app silently falls back to the pre-generated question bank and rule-based evaluation.
MAX_DAILY_AI_CALLS=700

# QUESTION_BANK_GROWTH_SCHEDULE: Cron schedule for automated background question generation (default: '0 3 * * 0', every Sunday at 3:00 AM server time).
QUESTION_BANK_GROWTH_SCHEDULE="0 3 * * 0"

# QUESTION_BANK_BATCH_SIZE: Target number of questions to generate and append per scheduled run (default: 40, typical range: 30-50).
QUESTION_BANK_BATCH_SIZE=40

# QUESTION_BANK_MAX_RUN_CALLS: Safety limit on AI calls per scheduled background run (default: 50).
# Uses dedicated accounting and does NOT count against the MAX_DAILY_AI_CALLS live visitor quota.
QUESTION_BANK_MAX_RUN_CALLS=50

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

